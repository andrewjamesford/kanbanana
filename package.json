{
  "name": "kanbanana",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "dev:api": "npm run dev -w @kanbanana/api",
    "dev:web": "npm run dev -w @kanbanana/web",
    "lint": "npm run lint --workspaces",
    "seed": "npm run seed -w @kanbanana/api",
    "test": "npm run test -w @kanbanana/api",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  },
  "overrides": {
    "qs": "^6.17.0"
  }
}
