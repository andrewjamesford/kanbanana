{
  "name": "@kanbanana/api",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --conditions=development src/index.ts",
    "lint": "tsc --noEmit -p tsconfig.json",
    "test": "node --conditions=development --import tsx --test src/**/*.test.ts",
    "start": "node dist/index.js",
    "seed": "tsx --conditions=development src/seed.ts"
  },
  "dependencies": {
    "@kanbanana/shared": "1.2.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.9",
    "express": "^5.3.0",
    "mongoose": "^9.11.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/supertest": "^7.2.1",
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
