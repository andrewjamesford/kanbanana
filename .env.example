# For running the API outside Docker. MongoDB must be a replica set for card moves.
PORT=4100
MONGODB_URI=mongodb://localhost:27017/kanbanana?replicaSet=rs0&directConnection=true
# Vite proxies /api to this host. Compose sets http://api:4100 instead.
API_PROXY_TARGET=http://localhost:4100
# Optional: set only if the browser must call a separately hosted API directly.
# VITE_API_URL=https://api.example.com
